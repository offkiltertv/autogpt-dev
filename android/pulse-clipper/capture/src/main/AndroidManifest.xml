<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 14 (API 34) MediaProjection foreground-service requirements. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only requested if mic / internal-audio capture is enabled (off by default in MVP). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <!--
          The capture service runs as a foreground service of type mediaProjection.
          It must be started (and shown as foreground) BEFORE MediaProjection is used,
          and must register a MediaProjection.Callback (Android 14). It is only ever
          started from an explicit user gesture (overlay tap / remote key).
          See docs/android-clipper-architecture.md §3.
        -->
        <service
            android:name=".service.ClipCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>

</manifest>
